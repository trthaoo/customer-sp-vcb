ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=
ZERNIO_PROFILE_ID_INSTAGRAM=
ZERNIO_PROFILE_ID_FACEBOOK=
ZERNIO_PROFILE_ID_TIKTOK=

MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# RAG embeddings: any OpenAI-compatible /v1/embeddings endpoint. Run the local
# bridge with `python scripts/embedding_bridge.py` (needs `pip install fastembed`).
# Empty EMBEDDING_BASE_URL disables RAG; replies still work without it.
EMBEDDING_BASE_URL=http://127.0.0.1:8789/v1
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_API_KEY=

# Password-protect the web UI and API (everything except /api/health and /webhooks/zernio).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Separate login for the ops console (/ops) and the session log APIs. Testers
# with BASIC_AUTH_* cannot open them. Empty ADMIN_PASS: the tester login opens them too.
ADMIN_USER=
ADMIN_PASS=

AUTO_SEND=false
HOLD_ON_HANDOVER=true

# Database (Optional: Set DATABASE_URL to persist logs on Render PostgreSQL, Neon.tech, or Supabase. If empty, uses local SQLite)
DATABASE_URL=
# DB_PATH=data/events.db

# PostHog Analytics & Session Recording
# Lấy Project API Key tại PostHog: Project Settings -> Project API Key (phc_...)
POSTHOG_API_KEY=
# Host mặc định của PostHog Cloud (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
POSTHOG_HOST=https://us.i.posthog.com
# Bật/tắt ghi hình phiên (true/false)
POSTHOG_ENABLE_RECORDING=true
