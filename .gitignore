# Environment variables & secrets (CRITICAL: DO NOT COMMIT)
.env

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest & IDE
.pytest_cache/
.vscode/
.idea/

# Runtime data: chat sessions, ratings (golden/failed cases), chat log backups
# and the RAG vector store. Lives only on the host so deploys never overwrite it.
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.log
*.mp4
*.webm

# Scratch scripts & temporary test artifacts
scratch/
.system_generated/

